WATERMARK_MAX_REPLICAS=6

# purpose: Target average CPU utilisation (percent of the CPU request) for the watermark HPA.
# type: int:10:95
# required: no
# scope: template
# env-specific: yes
# constraints: Integer percentage 10..95.
# depends: WATERMARK_CPU_REQUEST; metrics-server
