WATERMARK_HPA_CPU_TARGET=70

# purpose: CPU request of the watermark container (scheduler reservation).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity (e.g. 250m, 1). Must be <= WATERMARK_CPU_LIMIT.
# depends: WATERMARK_CPU_LIMIT; HPA targets are relative to this value
# change-impact: Rolling restart of the workload (pod template change). Image processing is CPU/memory hungry: measure before tuning.
WATERMARK_CPU_REQUEST=250m

# purpose: Memory request of the watermark container.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity (e.g. 256Mi, 1Gi). Must be <= WATERMARK_MEMORY_LIMIT.
# depends: WATERMARK_MEMORY_LIMIT
# change-impact: Rolling restart of the workload (pod template change). Image processing is CPU/memory hungry: measure before tuning.
WATERMARK_MEMORY_REQUEST=256Mi

# purpose: CPU limit of the watermark container (throttling ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= WATERMARK_CPU_REQUEST.
# depends: WATERMARK_CPU_REQUEST
# change-impact: Rolling restart of the workload (pod template change). Image processing is CPU/memory hungry: measure before tuning.
WATERMARK_CPU_LIMIT=2

# purpose: Memory limit of the watermark container (OOM-kill ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= WATERMARK_MEMORY_REQUEST.
# depends: WATERMARK_MEMORY_REQUEST
# change-impact: Rolling restart of the workload (pod template change). Image processing is CPU/memory hungry: measure before tuning.
WATERMARK_MEMORY_LIMIT=1Gi

