# purpose: HPA maxReplicas of the watermark service.
# type: int:1:50
# required: no
# scope: template
# env-specific: yes
# constraints: Integer >= WATERMARK_MIN_REPLICAS.
# depends: WATERMARK_MIN_REPLICAS
