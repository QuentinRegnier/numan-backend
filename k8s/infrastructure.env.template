# =====================================================================================================
# infrastructure.env.template - authoritative blueprint of every DEPLOYMENT-TIME variable of this repository.
#
# What this is: the variables substituted into the Kubernetes templates (and a few consumed by the CLI scripts)
# BEFORE kubectl sees anything. It is NOT the application's runtime configuration: JWT_SECRET, DB_DSN,
# REDIS_PASSWORD, ... stay in the ConfigMap/Secret architecture (01-config/) and never appear here.
#
# How to use: copy to infrastructure.env (git-ignored), replace every __REQUIRED__ value, adjust defaults,
# then `make render ENV_FILE=infrastructure.env`. Variables you omit take the default shown here; variables
# still set to __REQUIRED__ make the render fail.
#
# File format (conventional dotenv, parsed by scripts/envtool.py - never `source`d, never evaluated):
#   * one NAME=value per line; value = everything after the first '=' (optional matching single/double quotes
#     are stripped); no export keyword, no inline comments, no interpolation of other variables.
#   * values must not contain: $  `  "  '  \  # or control characters (spaces are allowed only in cron values).
#   * blank lines and lines starting with '#' are ignored.
#   * __REQUIRED__ is the explicit marker for "no safe default exists; the operator must provide a value".
#     A tool that turns this file into prompts should prompt for every variable whose value is __REQUIRED__.
#   * Never put secrets here (names containing PASSWORD, SECRET, TOKEN, KEY or CREDENTIAL are rejected by the
#     linter). Secrets are created by scripts/create-secrets.sh.
#
# Annotation grammar (machine-readable comments placed directly above each variable):
#   # purpose:         what the value controls
#   # type:            int:MIN:MAX | quantity | bool | cron | timezone | hostname | email | enum:a|b | image-registry |
#                      image-tag | image-ref | identifier | bucket | k8s-name | kube-context | semver |
#                      retention-mode | int-or-empty
#   # required:        yes (no safe default, must be provided) | no (default below is safe to keep)
#   # scope:           template (substituted into manifests) | cli (consumed by scripts only)
#   # env-specific:    yes if it is normally different between environments/clusters
#   # constraints:     format rules and relations to other variables
#   # depends:         related variables/resources
#   # change-impact:   what changing it later requires (recreation, migration, restart, data effects)
#   # allow-empty:     yes if an empty value is valid
# =====================================================================================================


# =====================================================================================================
# 1. Environment identification
# =====================================================================================================


# purpose: Short identifier of this deployment. Used as the restic host label of the database backups ('<name>-postgres', '<name>-mongo', '<name>-redis').
# type: identifier
# required: no
# scope: template
# env-specific: yes
# constraints: Lowercase letters, digits and '-', 2-32 characters.
# depends: BACKUP_* (backup-jobs.yaml)
# change-impact: Changing it after backups exist makes restic treat existing snapshots as belonging to another host: the retention policy (forget --prune) no longer applies to them. Keep it stable.
ENVIRONMENT_NAME=numan

# =====================================================================================================
# 2. Cluster and Cloud CLI configuration (consumed by the CLI scripts, not substituted into manifests)
# =====================================================================================================


# purpose: Name of the kubectl context the deployment is allowed to target. scripts/deploy.sh refuses to run when the current context differs (protection against deploying to the wrong cluster).
# type: kube-context
# required: yes
# scope: cli
# env-specific: yes
# constraints: Exact context name as shown by 'kubectl config get-contexts -o name'. No default exists on purpose.
# change-impact: None on the cluster. Changing it only changes which cluster the CLI accepts.
KUBE_CONTEXT=__REQUIRED__

# purpose: Kubernetes version whose JSON schemas kubeconform validates the rendered manifests against.
# type: semver
# required: no
# scope: cli
# env-specific: yes
# constraints: MAJOR.MINOR.PATCH. The manifests require Kubernetes >= 1.31.
# change-impact: None on the cluster; a wrong value only weakens validation. Align with the cluster's server version.
KUBERNETES_VERSION=1.35.0

# =====================================================================================================
# 3. Public domain and TLS
# =====================================================================================================


# purpose: Public DNS name served by Traefik: Ingress hosts (HTTPS app, watermark, HTTP redirect), Ingress TLS hosts and the Certificate dnsName.
# type: hostname
# required: yes
# scope: template
# env-specific: yes
# constraints: Lowercase RFC 1123 name with at least one dot, no wildcard, no IP, no scheme or port. 'deploy' rejects reserved placeholder domains (example.*, *.invalid, *.test, localhost).
# depends: DNS record; ports 80/443; TLS_ISSUER
# change-impact: Ingress rules and the Certificate are updated in place; a new name needs a new certificate (cert-manager re-issues; the old TLS Secret keeps serving the old name until then). DNS must point at the cluster first.
NUMAN_DOMAIN=__REQUIRED__

# purpose: Contact address registered with the ACME CA (Let's Encrypt) in both ClusterIssuers; receives expiry and account notices.
# type: email
# required: yes
# scope: template
# env-specific: yes
# constraints: Valid e-mail address of a monitored mailbox. 'deploy' rejects reserved placeholder domains.
# depends: cert-manager installed
# change-impact: ClusterIssuers are updated in place; the ACME account key Secret is kept.
ACME_EMAIL=__REQUIRED__

# purpose: ClusterIssuer used by the Certificate. Start with staging (untrusted certificate, generous rate limits); switch to production once issuance works.
# type: enum:letsencrypt-staging|letsencrypt-prod
# required: no
# scope: template
# env-specific: yes
# constraints: letsencrypt-staging or letsencrypt-prod (the names of the ClusterIssuers in 06-ingress/tls/cluster-issuers.yaml).
# depends: ACME_EMAIL, NUMAN_DOMAIN
# change-impact: Switching issuer re-issues the certificate only after the TLS Secret is deleted or the Certificate is renewed ('kubectl -n numan delete secret numan-tls'). Production issuance is rate limited.
TLS_ISSUER=letsencrypt-staging

# purpose: Whether the Strict-Transport-Security header carries includeSubDomains (legacy nginx behaviour: true). max-age stays 31536000 (1 year).
# type: bool
# required: no
# scope: template
# env-specific: yes
# constraints: true or false (lowercase).
# change-impact: Header changes immediately for new responses, but browsers that already cached includeSubDomains keep enforcing it for up to a year.
HSTS_INCLUDE_SUBDOMAINS=true

# =====================================================================================================
# 4. Container images
# =====================================================================================================


# purpose: Registry host (optionally with port) and path prefix under which the application images numan-api and numan-watermark are published. Image references become '<IMAGE_REGISTRY>/numan-api:<tag>' and '<IMAGE_REGISTRY>/numan-watermark:<tag>'.
# type: image-registry
# required: yes
# scope: template
# env-specific: yes
# constraints: host[:port][/path], lowercase, no scheme, no trailing slash (e.g. registry.internal:5000/numan). Private registries also need an imagePullSecret (see README). 'deploy' rejects reserved placeholder hosts.
# depends: API_IMAGE_TAG, WATERMARK_IMAGE_TAG
# change-impact: Rolling restart of the API, worker and watermark pods.
IMAGE_REGISTRY=__REQUIRED__

# purpose: Tag of the numan-api image. Used by the API StatefulSet and by the worker StatefulSet (same build, different command).
# type: image-tag
# required: yes
# scope: template
# env-specific: yes
# constraints: Valid image tag, max 128 characters. 'latest' is rejected (mutable). Prefer a release or commit tag that is never re-pushed.
# depends: IMAGE_REGISTRY
# change-impact: Rolling update of the API (one pod at a time) and, if enabled, the worker. Roll back with 'kubectl rollout undo'.
API_IMAGE_TAG=__REQUIRED__

# purpose: Tag of the numan-watermark image (the watermark service has its own image and release cycle).
# type: image-tag
# required: yes
# scope: template
# env-specific: yes
# constraints: Valid image tag. 'latest' is rejected.
# depends: IMAGE_REGISTRY
# change-impact: Rolling update of the watermark Deployment.
WATERMARK_IMAGE_TAG=__REQUIRED__

# purpose: Full reference of the MinIO server image for both minio-hot and minio-cold. The default is the last official community image on Quay, which pre-dates the fix for CVE-2025-62506; override with your own patched build (README, 'MinIO supply chain').
# type: image-ref
# required: no
# scope: template
# env-specific: yes
# constraints: Full reference with tag or sha256 digest; 'latest' rejected.
# depends: MINIO_MC_IMAGE (keep client and server compatible)
# change-impact: Restarts the MinIO StatefulSets (single replica: short downtime). Do not downgrade across MinIO releases without reading the release notes.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# purpose: Full reference of the MinIO client image used by the bootstrap Jobs and the MinIO backup CronJobs.
# type: image-ref
# required: no
# scope: template
# env-specific: yes
# constraints: Full reference with tag or sha256 digest; 'latest' rejected.
# depends: MINIO_IMAGE
# change-impact: Jobs are immutable: scripts/deploy.sh deletes finished init Jobs before applying; CronJobs pick it up on the next run.
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# =====================================================================================================
# 5. Storage classes and PVC capacities
# =====================================================================================================


# purpose: StorageClass for every StatefulSet volume (PostgreSQL, MongoDB, Redis, MinIO hot and cold). The StorageClass itself is owned by the cluster administrator and is not defined in this repository.
# type: k8s-name
# required: no
# scope: template
# env-specific: yes
# constraints: Name of an existing StorageClass (DNS subdomain). 'deploy' verifies it exists in the cluster.
# change-impact: IMMUTABLE: volumeClaimTemplates cannot be changed on an existing StatefulSet. Changing this after the first deployment does not migrate volumes; a migration (backup, recreate PVCs, restore) is required. local-path volumes are node-local and not replicated.
STORAGE_CLASS=local-path

# purpose: Capacity of the PostgreSQL data volume.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity, e.g. 50Gi. Size from current database size x growth plus headroom; PLACEHOLDER default, not a measurement.
# depends: STORAGE_CLASS; QUOTA_REQUESTS_STORAGE
# change-impact: IMMUTABLE in the StatefulSet template. Growing an existing PVC requires a StorageClass with allowVolumeExpansion and a manual PVC edit; shrinking is impossible; local-path does not support expansion.
PVC_SIZE_POSTGRES=50Gi

# purpose: Capacity of the MongoDB data volume.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. PLACEHOLDER default.
# depends: STORAGE_CLASS; QUOTA_REQUESTS_STORAGE
# change-impact: Same as PVC_SIZE_POSTGRES.
PVC_SIZE_MONGODB=50Gi

# purpose: Capacity of the Redis volume (AOF plus rewrite temporary files).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity; at least ~2.5x Redis maxmemory (4gb) is prudent. PLACEHOLDER default.
# depends: STORAGE_CLASS; QUOTA_REQUESTS_STORAGE
# change-impact: Same as PVC_SIZE_POSTGRES.
PVC_SIZE_REDIS=20Gi

# purpose: Capacity of the hot object-storage volume.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Size from current bucket size x growth. PLACEHOLDER default.
# depends: STORAGE_CLASS; QUOTA_REQUESTS_STORAGE
# change-impact: Same as PVC_SIZE_POSTGRES.
PVC_SIZE_MINIO_HOT=100Gi

# purpose: Capacity of the cold object-storage volume.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. PLACEHOLDER default.
# depends: STORAGE_CLASS; QUOTA_REQUESTS_STORAGE
# change-impact: Same as PVC_SIZE_POSTGRES.
PVC_SIZE_MINIO_COLD=100Gi

# =====================================================================================================
# 6. API
# =====================================================================================================


# purpose: Replica count written to the API StatefulSet and the HPA minReplicas (legacy: api1 + api2).
# type: int:1:10
# required: no
# scope: template
# env-specific: yes
# constraints: Integer 1..10 and <= API_MAX_REPLICAS.
# depends: API_MAX_REPLICAS
# change-impact: Re-applying the manifests resets the StatefulSet to this count, which momentarily undoes HPA scale-up until the HPA reacts. Scaling down disconnects WebSocket clients.
API_MIN_REPLICAS=2

# purpose: HPA maxReplicas of the API. API pods get NODE_ID = ordinal (starting at 1); workers start at 11, so the maximum must stay below 11. The application's own NODE_ID range is unverified.
# type: int:1:10
# required: no
# scope: template
# env-specific: yes
# constraints: Integer 1..10 and >= API_MIN_REPLICAS.
# depends: API_MIN_REPLICAS; PostgreSQL/MongoDB/Redis capacity
# change-impact: HPA change only. Scaling pods does not scale the single-instance databases: check connection limits first.
API_MAX_REPLICAS=6

# purpose: Target average CPU utilisation (percent of the CPU request) for the API HPA.
# type: int:10:95
# required: no
# scope: template
# env-specific: yes
# constraints: Integer percentage 10..95.
# depends: API_CPU_REQUEST; metrics-server
# change-impact: HPA change only. CPU may lag real saturation for WebSocket-heavy load.
API_HPA_CPU_TARGET=70

# purpose: CPU request of the API container (scheduler reservation).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity (e.g. 250m, 1). Must be <= API_CPU_LIMIT.
# depends: API_CPU_LIMIT; HPA targets are relative to this value
# change-impact: Rolling restart of the workload (pod template change).
API_CPU_REQUEST=250m

# purpose: Memory request of the API container.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity (e.g. 256Mi, 1Gi). Must be <= API_MEMORY_LIMIT.
# depends: API_MEMORY_LIMIT
# change-impact: Rolling restart of the workload (pod template change).
API_MEMORY_REQUEST=256Mi

# purpose: CPU limit of the API container (throttling ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= API_CPU_REQUEST.
# depends: API_CPU_REQUEST
# change-impact: Rolling restart of the workload (pod template change).
API_CPU_LIMIT=2

# purpose: Memory limit of the API container (OOM-kill ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= API_MEMORY_REQUEST.
# depends: API_MEMORY_REQUEST
# change-impact: Rolling restart of the workload (pod template change).
API_MEMORY_LIMIT=1Gi

# =====================================================================================================
# 7. Worker (disabled by default)
# =====================================================================================================


# purpose: Replica count of the dedicated worker StatefulSet. 0 = disabled: the legacy production stack ran background work inside the monolith API processes. Read the header of 05-apps/worker.yaml before enabling (duplicate-processing risk; ordinals start at 11).
# type: int:0:8
# required: no
# scope: template
# env-specific: yes
# constraints: Integer 0..8.
# depends: SERVER_ROLE of the API (application setting, not a deployment variable)
# change-impact: Enabling next to monolith APIs can process jobs twice unless the application claims jobs atomically/idempotently (unverified). Scale 0 -> 1 -> N deliberately.
WORKER_REPLICAS=0

# purpose: CPU request of the worker container (scheduler reservation).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity (e.g. 250m, 1). Must be <= WORKER_CPU_LIMIT.
# depends: WORKER_CPU_LIMIT
# change-impact: Rolling restart of the workload (pod template change).
WORKER_CPU_REQUEST=250m

# purpose: Memory request of the worker container.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity (e.g. 256Mi, 1Gi). Must be <= WORKER_MEMORY_LIMIT.
# depends: WORKER_MEMORY_LIMIT
# change-impact: Rolling restart of the workload (pod template change).
WORKER_MEMORY_REQUEST=256Mi

# purpose: CPU limit of the worker container (throttling ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= WORKER_CPU_REQUEST.
# depends: WORKER_CPU_REQUEST
# change-impact: Rolling restart of the workload (pod template change).
WORKER_CPU_LIMIT=2

# purpose: Memory limit of the worker container (OOM-kill ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= WORKER_MEMORY_REQUEST.
# depends: WORKER_MEMORY_REQUEST
# change-impact: Rolling restart of the workload (pod template change).
WORKER_MEMORY_LIMIT=1Gi

# =====================================================================================================
# 8. Watermark service
# =====================================================================================================


# purpose: Replica count of the watermark Deployment and the HPA minReplicas.
# type: int:1:50
# required: no
# scope: template
