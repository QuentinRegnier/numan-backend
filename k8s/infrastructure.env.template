# constraints: Kubernetes quantity (e.g. 256Mi, 1Gi). Must be <= MINIO_COLD_MEMORY_LIMIT.
# depends: MINIO_COLD_MEMORY_LIMIT
# change-impact: Rolling restart of the workload (pod template change). Single-replica restart: brief downtime.
MINIO_COLD_MEMORY_REQUEST=256Mi

# purpose: CPU limit of the cold MinIO container (throttling ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= MINIO_COLD_CPU_REQUEST.
# depends: MINIO_COLD_CPU_REQUEST
# change-impact: Rolling restart of the workload (pod template change). Single-replica restart: brief downtime.
MINIO_COLD_CPU_LIMIT=1

# purpose: Memory limit of the cold MinIO container (OOM-kill ceiling).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= MINIO_COLD_MEMORY_REQUEST.
# depends: MINIO_COLD_MEMORY_REQUEST
# change-impact: Rolling restart of the workload (pod template change). Single-replica restart: brief downtime.
MINIO_COLD_MEMORY_LIMIT=1Gi

# purpose: Name of the hot bucket. Feeds BOTH the application setting MINIO_BUCKET_NAME and the bootstrap Job, so they cannot diverge.
# type: bucket
# required: no
# scope: template
# env-specific: yes
# constraints: S3 bucket naming: 3-63 chars, lowercase letters, digits, '.' and '-'.
# depends: MINIO_HOT_* policy toggles
# change-impact: A new name creates a new empty bucket; existing objects are not moved. The application reads the name at start (restart the API).
MINIO_HOT_BUCKET=numan-bucket

# purpose: Name of the cold/archive bucket (a proposal: no cold bucket exists in the legacy configuration).
# type: bucket
# required: no
# scope: template
# env-specific: yes
# constraints: S3 bucket naming (3-63 chars, lowercase letters, digits, '.' and '-'). It may equal MINIO_HOT_BUCKET because the two MinIO instances are independent, but distinct names avoid confusion.
# depends: MINIO_COLD_* policy toggles
# change-impact: A new name creates a new empty bucket.
MINIO_COLD_BUCKET=numan-bucket-cold

# purpose: Anonymous (unauthenticated) read on the hot bucket. The legacy bootstrap script enabled it; the application streams media itself with its own credentials (confirmed), so the default is false.
# type: bool
# required: no
# scope: template
# env-specific: yes
# constraints: true or false. Enable only if some consumer reads unsigned object URLs inside the cluster.
# depends: NetworkPolicies (only labelled pods reach MinIO)
# change-impact: The bootstrap Job re-applies the value on every run: false REMOVES an anonymous policy from an already existing bucket. Re-run requires deleting the finished Job (scripts/deploy.sh does this).
MINIO_HOT_ANONYMOUS_READ=false

# purpose: Enable bucket versioning on the hot bucket (protects against accidental overwrite/delete, costs storage).
# type: bool
# required: no
# scope: template
# env-specific: yes
# constraints: true or false.
# change-impact: Reversible (versioning can be suspended, not removed).
MINIO_HOT_VERSIONING=false

# purpose: Enable bucket versioning on the cold bucket.
# type: bool
# required: no
# scope: template
# env-specific: yes
# constraints: true or false; must be true if MINIO_COLD_OBJECT_LOCK is true.
# change-impact: Reversible (can be suspended). Forced to true when object lock is enabled.
MINIO_COLD_VERSIONING=true

# purpose: Create the cold bucket with S3 Object Lock. DECISION REQUIRED BEFORE THE FIRST bootstrap run: Object Lock can only be enabled at bucket creation and cannot be converted later. Retention duration and mode are legal decisions (docs/01-ARCHITECTURE.md section 7).
# type: bool
# required: no
# scope: template
# env-specific: yes
# constraints: true or false.
# depends: MINIO_COLD_RETENTION_MODE, MINIO_COLD_RETENTION_DAYS
# change-impact: IRREVERSIBLE for that bucket once created with lock; a bucket created without lock must be recreated (with data migration) to gain it.
MINIO_COLD_OBJECT_LOCK=false

# purpose: Default retention mode applied to the cold bucket (GOVERNANCE or COMPLIANCE). Empty = no default retention.
# type: retention-mode
# required: no
# scope: template
# env-specific: yes
# constraints: Empty, GOVERNANCE or COMPLIANCE. Requires MINIO_COLD_OBJECT_LOCK=true and MINIO_COLD_RETENTION_DAYS.
# depends: MINIO_COLD_OBJECT_LOCK; MINIO_COLD_RETENTION_DAYS
# change-impact: COMPLIANCE retention cannot be shortened or removed by anyone until it expires. Choose deliberately.
# allow-empty: yes
MINIO_COLD_RETENTION_MODE=

# purpose: Default retention period in days for the cold bucket. Empty = none. NOT assumed to be 365: no supplied file states a legal retention duration.
# type: int-or-empty
# required: no
# scope: template
# env-specific: yes
# constraints: Empty or integer 1..36500. Requires MINIO_COLD_OBJECT_LOCK=true and a mode.
# depends: MINIO_COLD_OBJECT_LOCK; MINIO_COLD_RETENTION_MODE
# change-impact: See MINIO_COLD_RETENTION_MODE. Never shorten silently: legal decision.
# allow-empty: yes
MINIO_COLD_RETENTION_DAYS=

# =====================================================================================================
# 12. Namespace quotas (safety net against runaway scaling, not a capacity plan)
# =====================================================================================================


# purpose: ResourceQuota: total CPU requests allowed in the namespace.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be <= QUOTA_LIMITS_CPU. The renderer warns when the declared workloads (initial replicas) would not fit.
# depends: all *_CPU_REQUEST and replica counts
# change-impact: Pods that would exceed the quota are rejected at admission. Lowering below current usage does not evict running pods.
QUOTA_REQUESTS_CPU=12

# purpose: ResourceQuota: total memory requests allowed in the namespace.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be <= QUOTA_LIMITS_MEMORY.
# depends: all *_MEMORY_REQUEST and replica counts
# change-impact: Same as QUOTA_REQUESTS_CPU.
QUOTA_REQUESTS_MEMORY=40Gi

# purpose: ResourceQuota: total CPU limits allowed in the namespace.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= QUOTA_REQUESTS_CPU.
# depends: all *_CPU_LIMIT and replica counts (HPA maximum!)
# change-impact: Same as QUOTA_REQUESTS_CPU.
QUOTA_LIMITS_CPU=32

# purpose: ResourceQuota: total memory limits allowed in the namespace.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity. Must be >= QUOTA_REQUESTS_MEMORY.
# depends: all *_MEMORY_LIMIT and replica counts (HPA maximum!)
# change-impact: Same as QUOTA_REQUESTS_CPU.
QUOTA_LIMITS_MEMORY=80Gi

# purpose: ResourceQuota: total PVC storage requests allowed in the namespace.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity; must be >= the sum of all PVC_SIZE_* (checked).
# depends: PVC_SIZE_*
# change-impact: New PVCs beyond the quota are rejected.
QUOTA_REQUESTS_STORAGE=1Ti

# purpose: ResourceQuota: maximum number of pods in the namespace (includes Job/CronJob pods).
# type: int:1:1000
# required: no
# scope: template
# env-specific: yes
# constraints: Integer 1..1000.
# depends: HPA maxima; backup Jobs
# change-impact: New pods beyond the quota are rejected.
QUOTA_MAX_PODS=80

# =====================================================================================================
# 13. Ingress controller (optional cluster-wide Traefik tuning, applied separately)
# =====================================================================================================


# purpose: Replicas of the K3s-bundled Traefik, set by 06-ingress/optional/traefik-helmchartconfig.yaml (cluster-wide, kube-system). Only used when that optional stack is deployed ('make deploy-traefik').
# type: int:1:10
# required: no
# scope: template
# env-specific: yes
# constraints: Integer 1..10.
# depends: externalTrafficPolicy Local: DNS must target nodes running Traefik
# change-impact: Traefik rollout: connections handled by the old pods are drained. Needs that many schedulable nodes for real availability.
TRAEFIK_REPLICAS=2

# =====================================================================================================
# 14. Backup and recovery (destinations and credentials are NOT variables: they live in the Secret backup-credentials)
# =====================================================================================================


# purpose: Cron schedule (5 fields, interpreted in SYSTEM_TIMEZONE) of the PostgreSQL backup.
# type: cron
# required: no
# scope: template
# env-specific: yes
# constraints: Standard 5-field cron expression.
# depends: SYSTEM_TIMEZONE
# change-impact: Takes effect on the next controller sync; changes backup frequency and thus the RPO.
BACKUP_SCHEDULE_POSTGRES=15 2 * * *

# purpose: Cron schedule of the MongoDB backup.
# type: cron
# required: no
# scope: template
# env-specific: yes
# constraints: 5-field cron.
# depends: SYSTEM_TIMEZONE
# change-impact: As above.
BACKUP_SCHEDULE_MONGODB=45 2 * * *

# purpose: Cron schedule of the Redis snapshot backup.
# type: cron
# required: no
# scope: template
# env-specific: yes
# constraints: 5-field cron.
# depends: SYSTEM_TIMEZONE
# change-impact: As above.
BACKUP_SCHEDULE_REDIS=15 3 * * *

# purpose: Cron schedule of the hot MinIO mirror to the off-site bucket.
# type: cron
# required: no
# scope: template
# env-specific: yes
# constraints: 5-field cron.
# depends: SYSTEM_TIMEZONE
# change-impact: As above.
BACKUP_SCHEDULE_MINIO_HOT=30 4 * * *

# purpose: Cron schedule of the cold MinIO mirror to the off-site bucket.
# type: cron
# required: no
# scope: template
# env-specific: yes
# constraints: 5-field cron.
# depends: SYSTEM_TIMEZONE
# change-impact: As above.
BACKUP_SCHEDULE_MINIO_COLD=30 5 * * *

# purpose: restic retention: number of daily snapshots kept per database.
# type: int:1:3650
# required: no
# scope: template
# env-specific: yes
# constraints: Integer >= 1.
# depends: off-site repository capacity
# change-impact: Applied by 'restic forget --prune' at the end of each backup run: LOWERING IT PERMANENTLY DELETES older snapshots at the next run. Never lower without a decision on retention.
BACKUP_RETENTION_DAILY=14

# purpose: restic retention: number of weekly snapshots kept.
# type: int:1:520
# required: no
# scope: template
# env-specific: yes
# constraints: Integer >= 1.
# change-impact: As BACKUP_RETENTION_DAILY.
BACKUP_RETENTION_WEEKLY=8

# purpose: restic retention: number of monthly snapshots kept.
# type: int:1:240
# required: no
# scope: template
# env-specific: yes
# constraints: Integer >= 1.
# change-impact: As BACKUP_RETENTION_DAILY.
BACKUP_RETENTION_MONTHLY=12

# purpose: CPU limit of the restic / mc backup containers.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity >= 100m (the CPU request is fixed at 100m).
# change-impact: Applies to the next backup run.
BACKUP_CPU_LIMIT=1

# purpose: Memory limit of the restic / mc backup containers. restic can need more memory on large repositories.
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity >= 128Mi (the memory request is fixed at 128Mi).
# change-impact: Applies to the next run; too low = OOMKilled backup.
BACKUP_MEMORY_LIMIT=512Mi

# purpose: sizeLimit of the emptyDir that holds a database dump before it is uploaded. Must exceed the largest compressed dump (it lives on the node's disk).
# type: quantity
# required: no
# scope: template
# env-specific: yes
# constraints: Kubernetes quantity.
# change-impact: Applies to the next run; too small = evicted backup pod.
BACKUP_SCRATCH_SIZE=20Gi

# =====================================================================================================
# 15. Time zone
# =====================================================================================================


# purpose: IANA time zone in which the CronJob schedules are interpreted (CronJob spec.timeZone, GA since Kubernetes 1.27). Only the backup CronJobs use it.
# type: timezone
# required: no
# scope: template
# env-specific: yes
# constraints: IANA name (Area/Location or UTC). Must exist in the tz database of the cluster's controller: the renderer can only check the operator machine's database.
# depends: BACKUP_SCHEDULE_*
# change-impact: Changes the wall-clock time of every scheduled backup (and across DST transitions the UTC time). Does not touch container clocks.
SYSTEM_TIMEZONE=Europe/Paris

# =====================================================================================================
# 16. Email configuration (SMTP)
# =====================================================================================================
# purpose: Hostname of the SMTP server (maddy in prod, mailpit in local).
# type: hostname
# required: yes
# scope: template
# env-specific: yes
# constraints: Valid hostname (DNS or Kubernetes Service name).
# depends: networkpolicies (allow-ingress-to-maddy)
# change-impact: Rolling restart of the API and worker pods.
SMTP_HOST=__REQUIRED__

# purpose: Port of the SMTP server (usually 2525 for internal cluster traffic or 1025 in local).
# type: int:1:65535
# required: no
# scope: template
# env-specific: yes
# constraints: Integer between 1 and 65535.
# change-impact: Rolling restart of the API and worker pods.
SMTP_PORT=2525

# purpose: Default sender address for system emails (e.g. noreply@numan.com).
# type: email
# required: yes
# scope: template
# env-specific: yes
# constraints: Valid email address. The domain MUST match the DKIM and SPF configurations in production.
# change-impact: Rolling restart of the API and worker pods.
SMTP_FROM_ADDRESS=__REQUIRED__