# =============================================================================
# Profile preset: HA-CLUSTER (Production High Availability + Read Replicas)
# =============================================================================
# Full multi-node (or single-server multi-NVMe) HA topology with automatic election:
#   - PostgreSQL HA via CloudNativePG (03-databases-ha/): 3 instances (1 Primary + 2 Read Replicas)
#       * Writes  -> postgres-rw:5432
#       * Reads   -> postgres-ro:5432 (trafficDistribution: PreferClose)
#       * Standalone StatefulSet/postgres disabled (DB_POSTGRES_STANDALONE_REPLICAS=0)
#   - MongoDB HA (native StatefulSet): 3-node Replica Set rs0 (priority: mongo-0=2, mongo-1/2=1)
#       * Read preference: nearest (localThresholdMS=15 -> lowest RTT latency)
#   - Redis HA (native StatefulSet + Sentinel): 3 Redis nodes + 3 Sentinels (quorum=2)
#       * Automatic master election in ~5-15s without restarting API/WS/Worker pods
#   - Application roles decoupled: api_node + ws_node + worker_node
#   - Pod anti-affinity is SOFT (preferred): spreads across physical servers when available,
#     OR runs all 3 replicas on 1 physical server with 3 separate NVMe SSDs (see 04-storage/nvme-local-pv.example.yaml).
#
# Deployment sequence:
#   1. make install-cnpg                               (one-time CloudNativePG operator install)
#   2. cp profiles/ha-cluster.env.example infrastructure.env && edit __REQUIRED__ fields
#   3. make deploy-postgres-ha ENV_FILE=infrastructure.env
#   4. make deploy ENV_FILE=infrastructure.env

ENVIRONMENT_NAME=numan-fr-par
DC_ID=fr-par
DC_INDEX=0
CLUSTER_PROFILE=ha-cluster

KUBE_CONTEXT=__REQUIRED__
NUMAN_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__
IMAGE_REGISTRY=__REQUIRED__
API_IMAGE_TAG=__REQUIRED__
WATERMARK_IMAGE_TAG=__REQUIRED__
MAIL_FROM_ADDRESS=__REQUIRED__

# Application workload decoupling
API_SERVER_ROLE=api_node
API_MIN_REPLICAS=2
API_MAX_REPLICAS=16
API_NODE_ID_START=1

WS_BACKEND_SERVICE=websocket
WS_REPLICAS=2
WS_NODE_ID_START=64

WORKER_REPLICAS=2
WORKER_NODE_ID_START=96
WORKER_POOL_SIZE=128

# PostgreSQL HA (CloudNativePG: 1 Primary + 2 Read Replicas)
DB_POSTGRES_STANDALONE_REPLICAS=0
DB_POSTGRES_INSTANCES=3
DB_POSTGRES_HOST=postgres-rw
DB_POSTGRES_READ_HOST=postgres-ro
DB_POSTGRES_MAX_CONNECTIONS=400

# MongoDB HA (3-member native Replica Set rs0, lowest-latency reads)
DB_MONGO_REPLICAS=3
DB_MONGO_HOSTS=mongo-0.mongo-headless:27017,mongo-1.mongo-headless:27017,mongo-2.mongo-headless:27017
DB_MONGO_REPLICA_SET=rs0
DB_MONGO_READ_PREFERENCE=nearest
DB_MONGO_LOCAL_THRESHOLD_MS=15
DB_MONGO_PRIMARY_PRIORITY=2

# Redis HA (1 Primary + 2 Replicas + 3 Sentinels, quorum 2)
DB_REDIS_REPLICAS=3
DB_REDIS_SENTINEL_REPLICAS=3
DB_REDIS_MASTER_NAME=numan-master
DB_REDIS_SENTINEL_ADDRS=redis-sentinel-0.redis-sentinel-headless:26379,redis-sentinel-1.redis-sentinel-headless:26379,redis-sentinel-2.redis-sentinel-headless:26379
DB_REDIS_SENTINEL_QUORUM=2
DB_REDIS_SENTINEL_DOWN_AFTER_MS=5000
DB_REDIS_SENTINEL_FAILOVER_TIMEOUT_MS=15000
DB_REDIS_REPLICA_PRIORITY=100

# StorageClasses: keep local-path or switch to dedicated NVMe local-PV classes (04-storage/nvme-local-pv.example.yaml)
STORAGE_CLASS=local-path
STORAGE_CLASS_POSTGRES=local-path
STORAGE_CLASS_MONGODB=local-path
STORAGE_CLASS_REDIS=local-path

# ResourceQuota headroom for 3x PG + 3x Mongo + 3x Redis + 3x Sentinel + decoupled apps
QUOTA_MAX_PODS=120
QUOTA_REQUESTS_CPU=32
QUOTA_REQUESTS_MEMORY=64Gi
QUOTA_LIMITS_CPU=96
QUOTA_LIMITS_MEMORY=128Gi
QUOTA_REQUESTS_STORAGE=2Ti

# Enable TLS once internal DB certificates are provisioned on multi-node clusters
DB_POSTGRES_SSLMODE=disable
DB_MONGO_TLS=false
DB_REDIS_TLS=false
