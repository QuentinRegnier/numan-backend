# =============================================================================
# Profile preset: DEV-REPLICA-TEST (Compact 1 Primary + 1 Replica for Mac / Dev)
# =============================================================================
# Designed for local testing on a laptop (Mac / Docker Desktop / OrbStack / k3d / Colima)
# or a single small dev VPS to validate:
#   - PostgreSQL read/write split (postgres-rw vs postgres-ro) with 2 CNPG instances
#   - MongoDB secondaryPreferred/nearest reads with 2 rs0 members
#   - Redis Primary + 1 Replica replication (+ optional 3 lightweight Sentinels for failover drills)
#   - Manual failover drills (killing the primary pod) without needing 3x heavy RAM!
#
# IMPORTANT: 2-node Postgres/Mongo sets do NOT have automatic HA quorum if 1 node fails.
# `make render` succeeds with a clear dev-mode warning note; `make render-strict` / `make deploy`
# intentionally rejects 2-node sets so dev configs cannot accidentally ship to production.

ENVIRONMENT_NAME=numan-dev
DC_ID=dev-local
DC_INDEX=0
CLUSTER_PROFILE=dev-replica-test

KUBE_CONTEXT=__REQUIRED__
NUMAN_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__
IMAGE_REGISTRY=__REQUIRED__
API_IMAGE_TAG=__REQUIRED__
WATERMARK_IMAGE_TAG=__REQUIRED__
MAIL_FROM_ADDRESS=__REQUIRED__

# Compact monolith API (1..2 pods, no separate WS/Worker pods needed in local dev)
API_SERVER_ROLE=monolith
API_MIN_REPLICAS=1
API_MAX_REPLICAS=2
API_NODE_ID_START=1
WS_BACKEND_SERVICE=api
WS_REPLICAS=0
WORKER_REPLICAS=0
SCHEDULER_REPLICAS=0

# Compact resource requests/limits for Mac / single dev VPS
POSTGRES_CPU_REQUEST=200m
POSTGRES_MEMORY_REQUEST=384Mi
POSTGRES_CPU_LIMIT=1
POSTGRES_MEMORY_LIMIT=1Gi
MONGODB_CPU_REQUEST=200m
MONGODB_MEMORY_REQUEST=384Mi
MONGODB_CPU_LIMIT=1
MONGODB_MEMORY_LIMIT=1Gi
REDIS_CPU_REQUEST=100m
REDIS_MEMORY_REQUEST=256Mi
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=4608Mi
PVC_SIZE_POSTGRES=10Gi
PVC_SIZE_MONGODB=10Gi
PVC_SIZE_REDIS=5Gi
PVC_SIZE_MINIO_HOT=10Gi
PVC_SIZE_MINIO_COLD=10Gi

# PostgreSQL CNPG: 1 Primary + 1 Read Replica (test postgres-rw / postgres-ro locally)
DB_POSTGRES_STANDALONE_REPLICAS=0
DB_POSTGRES_INSTANCES=2
DB_POSTGRES_HOST=postgres-rw
DB_POSTGRES_READ_HOST=postgres-ro
DB_POSTGRES_MAX_CONNECTIONS=150

# MongoDB: 1 Primary + 1 Secondary (test secondaryPreferred / nearest locally)
DB_MONGO_REPLICAS=2
DB_MONGO_HOSTS=mongo-0.mongo-headless:27017,mongo-1.mongo-headless:27017
DB_MONGO_REPLICA_SET=rs0
DB_MONGO_READ_PREFERENCE=secondaryPreferred
DB_MONGO_LOCAL_THRESHOLD_MS=15
DB_MONGO_PRIMARY_PRIORITY=2

# Redis: 1 Primary + 1 Replica + 3 ultra-light Sentinels (each Sentinel uses ~32Mi RAM)
# Set DB_REDIS_SENTINEL_REPLICAS=0 and DB_REDIS_SENTINEL_ADDRS= if you do not want failover drills.
DB_REDIS_REPLICAS=2
DB_REDIS_SENTINEL_REPLICAS=3
DB_REDIS_MASTER_NAME=numan-master
DB_REDIS_SENTINEL_ADDRS=redis-sentinel-0.redis-sentinel-headless:26379,redis-sentinel-1.redis-sentinel-headless:26379,redis-sentinel-2.redis-sentinel-headless:26379
DB_REDIS_SENTINEL_QUORUM=2
DB_REDIS_SENTINEL_DOWN_AFTER_MS=5000
DB_REDIS_SENTINEL_FAILOVER_TIMEOUT_MS=15000
DB_REDIS_REPLICA_PRIORITY=100

QUOTA_MAX_PODS=60
QUOTA_REQUESTS_CPU=12
QUOTA_REQUESTS_MEMORY=24Gi
QUOTA_LIMITS_CPU=32
QUOTA_LIMITS_MEMORY=64Gi
QUOTA_REQUESTS_STORAGE=200Gi

DB_POSTGRES_SSLMODE=disable
DB_MONGO_TLS=false
DB_REDIS_TLS=false
