# =============================================================================
# Profile preset: DISTRIBUTED (multi-node production datacenter)
# =============================================================================
# Decouples workloads across specialized K3s nodes via numan.io/node-profile:
#   - API pods (SERVER_ROLE=api_node): REST only -> scheduled on profile 'api'
#   - WebSocket pods (SERVER_ROLE=ws_node): /ws only -> scheduled on profile 'websocket'
#   - Worker pods (SERVER_ROLE=worker_node): Write-Behind + Crons -> profile 'worker'
#   - Watermark pods: AVIF steganography -> profile 'watermark'
#   - Databases / MinIO: profile 'db' (or 'db-sql', 'db-mongo', 'db-redis') & 'storage'
#   - Snowflake DC 0 partition: NODE_ID 0..127 (API: 1..16, WS: 64..65, Worker: 96..97)
#
# Recommended for multi-node networks: enable DB TLS once server certs are provisioned.

ENVIRONMENT_NAME=numan-fr-par
DC_ID=fr-par
DC_INDEX=0
CLUSTER_PROFILE=distributed

KUBE_CONTEXT=__REQUIRED__
NUMAN_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__
IMAGE_REGISTRY=__REQUIRED__
API_IMAGE_TAG=__REQUIRED__
WATERMARK_IMAGE_TAG=__REQUIRED__
MAIL_FROM_ADDRESS=__REQUIRED__

API_SERVER_ROLE=api_node
API_MIN_REPLICAS=2
API_MAX_REPLICAS=16
API_NODE_ID_START=1

WS_BACKEND_SERVICE=websocket
WS_REPLICAS=2
WS_NODE_ID_START=64

WORKER_REPLICAS=2
WORKER_NODE_ID_START=96

# Adjust ResourceQuota headroom for distributed pod counts (API + WS + Workers + Watermark + DBs)
QUOTA_MAX_PODS=80
QUOTA_REQUESTS_CPU=24
QUOTA_REQUESTS_MEMORY=48Gi
QUOTA_LIMITS_CPU=64
QUOTA_LIMITS_MEMORY=96Gi

# Enable TLS once internal DB certificates are mounted on multi-node clusters
DB_POSTGRES_SSLMODE=disable
DB_MONGO_TLS=false
DB_REDIS_TLS=false
