# =============================================================================
# Profile preset: ALL-IN-ONE (1-node or small cluster, single datacenter)
# =============================================================================
# Runs the entire stack on 1+ servers labeled numan.io/node-profile=all-in-one:
#   - API pods run SERVER_ROLE=monolith (REST + WebSocket /ws + Write-Behind workers)
#   - Dedicated WebSocket (WS_REPLICAS=0) and Worker (WORKER_REPLICAS=0) disabled
#   - Traefik routes /ws directly to Service/api:8080
#   - Snowflake DC 0 partition: NODE_ID 0..127 (API: 1..6)
#
# Copy to k8s/infrastructure.env and replace __REQUIRED__ values before `make render`.

ENVIRONMENT_NAME=numan-fr-par
DC_ID=fr-par
DC_INDEX=0
CLUSTER_PROFILE=all-in-one

KUBE_CONTEXT=__REQUIRED__
NUMAN_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__
IMAGE_REGISTRY=__REQUIRED__
API_IMAGE_TAG=__REQUIRED__
WATERMARK_IMAGE_TAG=__REQUIRED__
MAIL_FROM_ADDRESS=__REQUIRED__

API_SERVER_ROLE=monolith
API_MIN_REPLICAS=2
API_MAX_REPLICAS=6
API_NODE_ID_START=1

WS_BACKEND_SERVICE=api
WS_REPLICAS=0
WS_NODE_ID_START=64

WORKER_REPLICAS=0
WORKER_NODE_ID_START=96

DB_POSTGRES_SSLMODE=disable
DB_MONGO_TLS=false
DB_REDIS_TLS=false
