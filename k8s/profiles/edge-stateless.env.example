# =============================================================================
# Profile preset: EDGE-STATELESS (second datacenter, e.g. Germany de-fra)
# =============================================================================
# Secondary regional datacenter with its own K3s cluster and non-overlapping
# Snowflake NODE_ID block:
#   - DC_INDEX=1 -> Snowflake partition 128..255
#   - API (api_node):       NODE_ID 129..144
#   - WebSocket (ws_node):  NODE_ID 192..193
#   - Worker (worker_node): NODE_ID 224..225
#
# Validate multiple datacenters together with:
#   make -C k8s check-fleet ENV_FILES="dc-fr-par.env dc-de-fra.env"

ENVIRONMENT_NAME=numan-de-fra
DC_ID=de-fra
DC_INDEX=1
CLUSTER_PROFILE=edge-stateless

KUBE_CONTEXT=__REQUIRED__
NUMAN_DOMAIN=__REQUIRED__
ACME_EMAIL=__REQUIRED__
IMAGE_REGISTRY=__REQUIRED__
API_IMAGE_TAG=__REQUIRED__
WATERMARK_IMAGE_TAG=__REQUIRED__
MAIL_FROM_ADDRESS=__REQUIRED__

API_SERVER_ROLE=api_node
API_MIN_REPLICAS=2
API_MAX_REPLICAS=16
API_NODE_ID_START=129

WS_BACKEND_SERVICE=websocket
WS_REPLICAS=2
WS_NODE_ID_START=192

WORKER_REPLICAS=2
WORKER_NODE_ID_START=224

QUOTA_MAX_PODS=80
QUOTA_REQUESTS_CPU=24
QUOTA_REQUESTS_MEMORY=48Gi
QUOTA_LIMITS_CPU=64
QUOTA_LIMITS_MEMORY=96Gi

DB_POSTGRES_SSLMODE=disable
DB_MONGO_TLS=false
DB_REDIS_TLS=false
