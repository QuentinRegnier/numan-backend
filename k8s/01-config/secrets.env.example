# Copy to 01-config/secrets.env (git-ignored, chmod 600) and fill EVERY value you use.
# Format: KEY=VALUE (everything after the first "=" is taken literally; no quotes needed).
#
# Rules:
#  * JWT_SECRET, HMAC_SECRET, WATERMARK_SECRET_KEY: reuse the EXISTING production values,
#    otherwise every issued token/signature becomes invalid at cut-over.
#  * WATERMARK_SECRET_KEY in the legacy .env looks human-readable/guessable: plan a rotation.
#  * Passwords/keys: avoid spaces, quotes, backslashes and '$' - the Postgres DSN is a
#    space-separated key=value string. Hex is safest:  openssl rand -hex 32
#  * Never commit this file. Keep an encrypted copy off-cluster (password manager / SOPS+age).

POSTGRES_USER=
POSTGRES_PASSWORD=

MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

REDIS_PASSWORD=

JWT_SECRET=
HMAC_SECRET=
WATERMARK_SECRET_KEY=

MINIO_HOT_ROOT_USER=
MINIO_HOT_ROOT_PASSWORD=
MINIO_HOT_APP_ACCESS_KEY=
MINIO_HOT_APP_SECRET_KEY=
MINIO_HOT_BACKUP_ACCESS_KEY=
MINIO_HOT_BACKUP_SECRET_KEY=

MINIO_COLD_ROOT_USER=
MINIO_COLD_ROOT_PASSWORD=
MINIO_COLD_APP_ACCESS_KEY=
MINIO_COLD_APP_SECRET_KEY=
MINIO_COLD_BACKUP_ACCESS_KEY=
MINIO_COLD_BACKUP_SECRET_KEY=

# Off-site backups (S3-compatible storage OUTSIDE this cluster)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_MIRROR_BUCKET=

# Admin tools (optional; leave empty to skip creating these three Secrets)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
MONGO_UI_USER=
MONGO_UI_PASSWORD=
REDIS_UI_USER=
REDIS_UI_PASSWORD=
